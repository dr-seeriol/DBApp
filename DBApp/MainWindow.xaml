<Window x:Class="DBApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DBApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/> 
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="People" FontSize="24" FontWeight="Bold" FontFamily="Papyrus"/>
            
                       
        </StackPanel>

        
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <Label Content="S_earch" Target="{Binding ElementName=SearchTextBox}" Padding="0,0,0,2"/>
            <TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged"/>
        </StackPanel>

        
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Sort by _Name" Padding="10,4" Margin="0,0,10,0" Click="SortByName_Click"/>
                <Button Content="S_ort by Age" Padding="10,4" Click="SortByAge_Click"/>
            </StackPanel>
            <TextBlock x:Name="SortStatusTextBlock" HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>

       
        <DataGrid x:Name="PeopleGrid" Grid.Row="4" Margin="0,0,0,10"
                  ItemsSource="{Binding People}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="*"/>
                <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="*"/>
                <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        
        <GroupBox Grid.Row="5" Header="Selected Person" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <Label Content="_First Name" Target="{Binding ElementName=FirstNameTextBox}" Padding="0,0,0,2"/>
                    <TextBox x:Name="FirstNameTextBox"
                             Text="{Binding SelectedItem.FirstName, ElementName=PeopleGrid, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <Label Content="_Last Name" Target="{Binding ElementName=LastNameTextBox}" Padding="0,0,0,2"/>
                    <TextBox x:Name="LastNameTextBox"
                             Text="{Binding SelectedItem.LastName, ElementName=PeopleGrid, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Label Content="A_ge" Target="{Binding ElementName=AgeTextBox}" Padding="0,0,0,2"/>
                    <TextBox x:Name="AgeTextBox"
                             Text="{Binding SelectedItem.Age, ElementName=PeopleGrid, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        
        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="_Add Person" Padding="10,4" Margin="0,0,10,0" Click="AddPerson_Click"/>
            <Button Content="_Delete Person" Padding="10,4" Margin="0,0,10,0" Click="DeletePerson_Click"/>
            <Button Content="_Save Changes" Padding="10,4" Click="SaveChanges_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="7" Text="To edit entries, the a generic 'new person' entry must be made"/>
    </Grid>
</Window>
